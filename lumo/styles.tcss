Screen { }

#title-bar {
    dock: top;
    width: 100%;
    height: 4;
    padding: 0 2;
    background: #171C26;
    border-bottom: solid #30394A;
}

/* --- Runtime Launcher --- */

#scenario-select {
    width: 100%;
    height: 1fr;
    background: #10151E;
    padding: 2 3;
    align: center middle;
}

#scenario-launcher {
    width: 100%;
    height: 1fr;
    min-height: 22;
    max-width: 142;
}

#launcher-intro {
    width: 28;
    height: 100%;
    padding: 3 3 2 2;
    background: #171D28;
    border: solid #344052;
}

#fox-mark {
    width: 100%;
    height: 5;
    color: #FFE8C2;
    text-style: bold;
}

#launcher-brand {
    margin-top: 1;
    width: 100%;
    color: #FFE4A3;
    text-style: bold;
}

#launcher-copy {
    margin-top: 1;
    width: 100%;
    color: #AAB5C8;
}

#launcher-keys {
    dock: bottom;
    width: 100%;
    color: #758199;
}

#scenario-browser {
    width: 1fr;
    height: 100%;
    padding: 3 2;
    background: #1A202C;
    border-top: solid #344052;
    border-bottom: solid #344052;
}

#scenario-select-label,
#scenario-preview-label {
    width: 100%;
    height: 1;
    color: #F6C84D;
    text-style: bold;
}

#scenario-select-subtitle {
    width: 100%;
    height: 2;
    margin-top: 1;
    color: #98A5B9;
}

#scenario-list {
    width: 100%;
    height: 1fr;
    margin-top: 1;
    padding: 0 1;
    background: #141A24;
    border: solid #30394A;
    color: #E6EBF4;
}

OptionList > .option-list--option {
    height: 3;
    padding: 0 1;
    color: #E6EBF4;
}

OptionList > .option-list--option-highlighted {
    background: #2B3445;
    color: #FFFFFF;
    text-style: bold;
}

OptionList > .option-list--option-disabled {
    color: #8A5F67;
}

#scenario-preview {
    width: 40;
    height: 100%;
    padding: 3 3;
    background: #171D28;
    border: solid #344052;
}

#scenario-detail {
    width: 100%;
    height: 1fr;
    margin-top: 1;
    padding: 1 0;
    color: #D8DFEA;
}

#provider-select {
    align: center middle;
    width: 100%;
    height: 1fr;
    background: #10151E;
}

#select-label {
    text-align: center;
    width: 100%;
    height: auto;
    margin-top: 2;
    text-style: bold;
}

#provider-list {
    width: 60;
    height: auto;
    max-height: 16;
    margin: 1 2;
    background: #171D28;
    border: solid #344052;
}

/* --- Chat Area --- */

#chat-area {
    height: 1fr;
    min-height: 18;
    padding: 1 2;
    background: #10151E;
}

.message {
    padding: 1 2;
    margin: 0 0 1 0;
    width: 100%;
    height: auto;
    background: #171D28;
    border-left: solid #344052;
}

.user-row {
    height: auto;
    width: 100%;
}

.user-message {
    color: #F4F7FB;
}

.ai-row {
    height: auto;
    width: 100%;
}

.ai-message {
    color: #E4E9F2;
}

.error-message {
    color: $error;
    padding: 0 2;
}

.system-message {
    color: #AAB5C8;
    padding: 0 2;
}

/* --- Tool Call Block --- */

.tool-block {
    padding: 1 2;
    width: auto;
    height: auto;
    color: #D6DEEA;
    background: #141A24;
    border-left: solid #D99825;
}

.tool-block-loading {
    color: $text-muted;
}

.tool-block-error {
    color: $error;
}

/* --- Thinking Display --- */

.thinking-done {
    color: $text-muted;
    text-style: italic;
}

/* --- Sub-Agent Block --- */

.subagent-block {
    color: $text;
    padding: 0 2;
}

/* --- Input Area --- */

#spinner-live {
    height: 1;
    padding: 0 2;
}

#input-area {
    dock: bottom;
    height: auto;
    max-height: 20;
    padding: 1 2 0 2;
    background: #171D28;
    border-top: solid #344052;
}

#chat-input {
    height: auto;
    min-height: 1;
    max-height: 10;
    padding: 0 1;
    color: #F4F7FB;
    background: #10151E;
    border: solid #344052;
}

#chat-input:focus {
    border: solid #F6C84D;
}

#status-bar {
    height: auto;
    min-height: 1;
    width: 100%;
    padding: 0 1;
    background: #171D28;
    border-top: solid #30394A;
}

#mode-label {
    width: auto;
    height: 1;
    color: #AAB5C8;
    padding: 0 1;
}

#scenario-label {
    width: auto;
    height: 1;
    color: #F5D16A;
    padding: 0 1;
}

#teammates-label {
    width: auto;
    height: 1;
    padding: 0 1;
}

#model-label {
    width: 1fr;
    height: 1;
    text-align: right;
    color: #AAB5C8;
}

/* --- Teammate Tree --- */

#teammate-tree {
    height: auto;
    padding: 0 2;
}

/* --- Plan Approval Dialog --- */

PlanApprovalDialog {
    align: center middle;
}

#plan-dialog {
    width: 64;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: solid $warning;
}

#plan-title {
    text-style: bold;
    text-align: center;
    padding: 0 0 1 0;
}

#plan-dialog Button {
    width: 100%;
    margin: 0 0 1 0;
}

/* --- AskUser Dialog --- */

AskUserDialog {
    align: center middle;
}

#askuser-dialog {
    width: 64;
    height: auto;
    max-height: 20;
    padding: 1 2;
    background: $surface;
    border: solid $accent;
}

#askuser-title {
    text-style: bold;
    text-align: center;
    padding: 0 0 1 0;
}

#askuser-options {
    height: auto;
    max-height: 12;
}

/* --- Inline Permission Widget --- */

#perm-inline {
    height: auto;
    padding: 0 0;
    margin: 0 0;
}

#perm-content {
    padding: 0 0;
}

/* --- Inline Plan Widget --- */

#plan-inline {
    height: auto;
    padding: 0 0;
}

#plan-content {
    padding: 0 0;
}

/* --- Inline AskUser Widget --- */

#askuser-inline {
    height: auto;
    padding: 0 0;
}

#askuser-content {
    padding: 0 0;
}

/* --- Inline Resume Widget --- */

#resume-inline {
    height: auto;
    padding: 0 0;
}

#resume-content {
    padding: 0 0;
}

/* --- Scenario Runtime --- */

#scenario-inline,
#scenario-editor-inline,
#scenario-switch-inline,
#scenario-draft-review {
    height: auto;
    margin: 1 1;
    padding: 0 1;
    border-left: solid $secondary;
}

#scenario-content,
#scenario-editor-content,
#scenario-switch-content,
#scenario-draft-content {
    height: auto;
    padding: 0;
}
